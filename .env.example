# Configuration values only; keep secrets in an ignored .dev.vars file.
CLOUDFLARE_ACCOUNT_ID=
BRAID_WORKER_NAME=braid-git
BRAID_AUTH_MODE=owner-key
BRAID_SIGNUP_ENABLED=false
BRAID_DAILY_TASK_LIMIT=20
BRAID_GLOBAL_DAILY_TASK_LIMIT=100

# Public account deployment: use a separate Worker while verifying providers.
# BRAID_WORKER_NAME=braid-production
# BRAID_AUTH_MODE=github
# BRAID_PUBLIC_ORIGIN=https://your-braid-domain.example
# BRAID_GITHUB_CLIENT_ID=
# BRAID_EMAIL_FROM=signin@your-braid-domain.example
# BRAID_ARTIFACTS_NAMESPACE=braid-production
# Put SESSION_SECRET and GITHUB_CLIENT_SECRET in .dev.vars.production.
# Follow docs/PRODUCTION.md before setting BRAID_SIGNUP_ENABLED=true.

# Optional GitHub App for imports, linking and merging. It is separate from the sign-in OAuth app.
# BRAID_GITHUB_APP_ID=
# BRAID_GITHUB_APP_SLUG=
# BRAID_GITHUB_APP_CLIENT_ID=
# BRAID_GITHUB_WEBHOOKS=1
# Put GITHUB_APP_CLIENT_SECRET, GITHUB_APP_PRIVATE_KEY and GITHUB_APP_WEBHOOK_SECRET in .dev.vars.production.
# Configure this App only for the production origin.

# Optional digest-pinned image already uploaded to this account's Cloudflare registry.
# Without this value, cf builds sandbox/Dockerfile and uploads the image.
# BRAID_SANDBOX_IMAGE=registry.cloudflare.com/ACCOUNT/IMAGE@sha256:DIGEST

# Local remote resources are opt-in. Default dev uses the recorded example.
# BRAID_REMOTE_DEV=1
