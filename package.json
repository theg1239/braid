{
  "name": "cf-git",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "preflight": "node scripts/preflight.mjs --env-file .env.production --secrets-file .dev.vars.production",
    "deploy:public": "npm run preflight && node --env-file=.env.production node_modules/cf/bin/cf deploy --secrets-file .dev.vars.production",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "vitest run",
    "build:cli": "rolldown -c cli/rolldown.config.ts",
    "braid": "node cli/dist/braid.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "^1.5.2",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@valibot/to-json-schema": "^1.8.0",
    "diff": "^9.0.0",
    "gsap": "^3.15.0",
    "isomorphic-git": "^1.43.0",
    "jose": "^6.2.12",
    "marked": "^18.1.0",
    "memfs": "^4.80.0",
    "oauth4webapi": "^3.8.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@levischuck/tiny-cbor": "^0.3.6",
    "@stricli/core": "^1.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "^1.0.0-beta.17",
    "playwright-core": "^1.64.0",
    "postcss": "^8.5.29",
    "rolldown": "~1.2.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
